-- Принцип 9: Концентрация на проблемных областях

SELECT 'employees' AS module, COUNT(*) AS error_count
FROM employees
WHERE email !~ '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'
   OR phone_number !~ '^\+7\(\d{3}\)\d{3}-\d{2}-\d{2}$'
UNION ALL
SELECT 'branches', COUNT(*)
FROM branches
WHERE branch_email !~ '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'
UNION ALL
SELECT 'positions', COUNT(*)
FROM positions
WHERE min_salary > max_salary OR min_salary < 0 OR max_salary < 0
UNION ALL
SELECT 'accruals', COUNT(*)
FROM accruals
WHERE summa <= 0 OR accrual_date > CURRENT_DATE;

WITH problem_employees AS (
    SELECT e.employee_id, e.last_name,
           (SELECT COUNT(*) FROM accruals a WHERE a.employee_id = e.employee_id) as accrual_count,
           (SELECT COUNT(DISTINCT exb.branch_id) FROM employees_x_branches exb 
            WHERE exb.employee_id = e.employee_id AND exb.end_date IS NULL) as active_branches
    FROM employees e
)
SELECT * FROM problem_employees
WHERE accrual_count > 5 OR active_branches > 1;

