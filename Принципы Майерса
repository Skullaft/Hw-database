-- Принцип 2-3: Независимое тестирование

SELECT e.employee_id, e.last_name, e.first_name
FROM employees e
LEFT JOIN employees_x_branches exb ON e.employee_id = exb.employee_id
WHERE exb.employee_id IS NULL;

SELECT e.employee_id, e.last_name, es.salary_amount, p.min_salary, p.max_salary, p.position_name
FROM employees e
JOIN employees_x_positions exp ON e.employee_id = exp.employee_id AND exp.end_date IS NULL
JOIN positions p ON exp.position_id = p.position_id
JOIN employees_salaries es ON e.employee_id = es.employee_id AND es.end_date IS NULL
WHERE es.salary_amount < p.min_salary OR es.salary_amount > p.max_salary;

SELECT email, COUNT(*) FROM employees GROUP BY email HAVING COUNT(*) > 1;

SELECT branch_name, COUNT(*) FROM branches GROUP BY branch_name HAVING COUNT(*) > 1;

SELECT country_name, COUNT(*) FROM countries GROUP BY country_name HAVING COUNT(*) > 1;

-- Принцип 4: Тщательная проверка результатов

SELECT employee_id, phone_number
FROM employees
WHERE phone_number !~ '^\+7\(\d{3}\)\d{3}-\d{2}-\d{2}$' OR phone_number IS NULL;

SELECT a.accrual_id, e.last_name, at.type_name, a.summa, a.accrual_date
FROM accruals a
JOIN employees e ON a.employee_id = e.employee_id
JOIN accurals_type at ON a.accrual_type_id = at.accrual_type_id
WHERE a.summa <= 0 OR a.accrual_date > CURRENT_DATE OR a.accrual_date < '2020-01-01';

SELECT 'branches' AS table_name, COUNT(*) AS invalid_records
FROM employees_x_branches WHERE end_date IS NOT NULL AND start_date > end_date
UNION ALL
SELECT 'positions', COUNT(*) FROM employees_x_positions WHERE end_date IS NOT NULL AND start_date > end_date
UNION ALL
SELECT 'salaries', COUNT(*) FROM employees_salaries WHERE end_date IS NOT NULL AND start_date > end_date;

SELECT e.employee_id, e.last_name, e.first_name, COUNT(exb.employee_branch_id) AS branch_count
FROM employees e
LEFT JOIN employees_x_branches exb ON e.employee_id = exb.employee_id AND exb.end_date IS NULL
GROUP BY e.employee_id, e.last_name, e.first_name
HAVING COUNT(exb.employee_branch_id) = 0;

