-- Принцип 7: Многоразовые тест-кейсы

CREATE OR REPLACE FUNCTION test_database_integrity()
RETURNS TABLE(test_name TEXT, test_result BOOLEAN, error_message TEXT) AS $$
DECLARE
    v_count INT;
BEGIN
    SELECT COUNT(*) INTO v_count
    FROM employees e
    LEFT JOIN employees_x_branches exb ON e.employee_id = exb.employee_id
    WHERE exb.employee_id IS NULL;
    
    test_name := 'Все сотрудники имеют филиалы';
    test_result := (v_count = 0);
    error_message := CASE WHEN v_count > 0 THEN 'Найдено сотрудников без филиала: ' || v_count ELSE NULL END;
    RETURN NEXT;

    SELECT COUNT(*) INTO v_count
    FROM branches b
    LEFT JOIN locations l ON b.location_id = l.location_id
    WHERE l.location_id IS NULL;
    
    test_name := 'Все филиалы имеют локации';
    test_result := (v_count = 0);
    error_message := CASE WHEN v_count > 0 THEN 'Найдено филиалов без локации: ' || v_count ELSE NULL END;
    RETURN NEXT;

    SELECT COUNT(*) INTO v_count
    FROM employees e
    JOIN employees_x_positions exp ON e.employee_id = exp.employee_id AND exp.end_date IS NULL
    JOIN positions p ON exp.position_id = p.position_id
    JOIN employees_salaries es ON e.employee_id = es.employee_id AND es.end_date IS NULL
    WHERE es.salary_amount < p.min_salary OR es.salary_amount > p.max_salary;
    
    test_name := 'Зарплаты в допустимых пределах';
    test_result := (v_count = 0);
    error_message := CASE WHEN v_count > 0 THEN 'Найдено зарплат вне диапазона: ' || v_count ELSE NULL END;
    RETURN NEXT;

    SELECT COUNT(*) INTO v_count
    FROM (SELECT email FROM employees GROUP BY email HAVING COUNT(*) > 1) duplicates;
    
    test_name := 'Нет дубликатов email';
    test_result := (v_count = 0);
    error_message := CASE WHEN v_count > 0 THEN 'Найдено дубликатов email: ' || v_count ELSE NULL END;
    RETURN NEXT;

    SELECT COUNT(*) INTO v_count
    FROM employees_x_branches WHERE end_date IS NOT NULL AND start_date > end_date;
    
    test_name := 'Даты филиалов корректны';
    test_result := (v_count = 0);
    error_message := CASE WHEN v_count > 0 THEN 'Найдено некорректных дат: ' || v_count ELSE NULL END;
    RETURN NEXT;

    SELECT COUNT(*) INTO v_count
    FROM employees_x_positions WHERE end_date IS NOT NULL AND start_date > end_date;
    
    test_name := 'Даты должностей корректны';
    test_result := (v_count = 0);
    error_message := CASE WHEN v_count > 0 THEN 'Найдено некорректных дат: ' || v_count ELSE NULL END;
    RETURN NEXT;

    SELECT COUNT(*) INTO v_count
    FROM employees_salaries WHERE end_date IS NOT NULL AND start_date > end_date;
    
    test_name := 'Даты зарплат корректны';
    test_result := (v_count = 0);
    error_message := CASE WHEN v_count > 0 THEN 'Найдено некорректных дат: ' || v_count ELSE NULL END;
    RETURN NEXT;

    SELECT COUNT(*) INTO v_count
    FROM positions WHERE min_salary > max_salary;
    
    test_name := 'Диапазоны зарплат корректны';
    test_result := (v_count = 0);
    error_message := CASE WHEN v_count > 0 THEN 'Найдено некорректных диапазонов: ' || v_count ELSE NULL END;
    RETURN NEXT;
END;
$$ LANGUAGE plpgsql;

SELECT * FROM test_database_integrity();

DROP FUNCTION IF EXISTS test_database_integrity();

